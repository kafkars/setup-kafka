#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

node scripts/lint.mjs
node --run typecheck
node --test test/*.test.*
node bin/setup-kafka.ts catalog >/dev/null
node bin/setup-kafka.ts plan \
  --version 4.3.1 \
  --topology three-broker \
  --security scram-sha-512 \
  --topics $'orders:6:3\npayments:3:3' >/dev/null
